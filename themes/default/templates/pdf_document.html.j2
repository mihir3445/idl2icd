<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>{{ print_css }}</style>
</head>
<body>

<div class="cover">
  <h1>{{ project.name }}</h1>
  <p>{{ project.organization }}</p>
  <p>Version {{ project.version }}</p>
  <p style="font-size:9px;color:#999;">Generated by idl2icd</p>
</div>

<h2>Topic Index</h2>
<table>
  <thead><tr><th>Topic</th><th>Criticality</th><th>Reliability</th><th>Durability</th><th>Publishers</th><th>Subscribers</th></tr></thead>
  <tbody>
  {% for t in all_topics %}
    <tr>
      <td>{{ t.fqn }}</td>
      <td><span class="badge badge-{{ t.criticality or 'none' }}">{{ t.criticality or "—" }}</span></td>
      <td>{{ t.qos.reliability }}</td>
      <td>{{ t.qos.durability }}</td>
      <td>{{ t.publishers|length }}</td>
      <td>{{ t.subscribers|length }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if diagnostics %}
<h2>Validation Results</h2>
<ul class="diagnostics">
  {% for d in diagnostics %}
  <li class="diag diag-{{ d.severity }}"><strong>[{{ d.severity|upper }}] {{ d.rule }}</strong> — {{ d.message }}</li>
  {% endfor %}
</ul>
{% endif %}

<h2>Publish/Subscribe Topology</h2>
<div class="diagram-note">
  Diagram omitted in PDF export (mermaid source pre-rendering not yet wired in this build —
  see the website output for the interactive version). Mermaid source:
  <pre>{{ pubsub_graph }}</pre>
</div>

{% for topic in all_topics %}
<div class="topic-section">
  <h2>{{ topic.fqn }}</h2>
  {% if topic.criticality %}<span class="badge badge-{{ topic.criticality }}">{{ topic.criticality }}</span>{% endif %}
  <p>{{ topic.description or "No description provided." }}</p>

  <h3>QoS</h3>
  <table>
    <tr><th>Reliability</th><td>{{ topic.qos.reliability }}</td></tr>
    <tr><th>Durability</th><td>{{ topic.qos.durability }}</td></tr>
    <tr><th>History</th><td>{{ topic.qos.history.kind }} ({{ topic.qos.history.depth }})</td></tr>
    {% if topic.qos.deadline %}<tr><th>Deadline</th><td>{{ topic.qos.deadline.period_ms }} ms</td></tr>{% endif %}
    {% if topic.rate %}<tr><th>Rate</th><td>nominal {{ topic.rate.nominal_hz }} Hz / max {{ topic.rate.max_hz }} Hz</td></tr>{% endif %}
  </table>

  <h3>Publishers</h3>
  <table>
    <thead><tr><th>Participant</th><th>Instance count</th><th>Source</th></tr></thead>
    <tbody>
    {% for p in topic.publishers %}
      <tr><td>{{ p.participant }}</td><td>{{ p.instance_count or "" }}</td><td>{{ p.source or "" }}</td></tr>
    {% else %}
      <tr><td colspan="3"><em>none declared</em></td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h3>Subscribers</h3>
  <table>
    <thead><tr><th>Participant</th><th>Notes</th></tr></thead>
    <tbody>
    {% for s in topic.subscribers %}
      <tr><td>{{ s.participant }}</td><td>{{ s.notes or "" }}</td></tr>
    {% else %}
      <tr><td colspan="2"><em>none declared</em></td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h3>Data Type: {{ topic.data_type.fqn }}</h3>
  <table>
    <thead><tr><th>Field</th><th>Type</th><th>Key</th><th>Unit</th><th>Description</th></tr></thead>
    <tbody>
    {% for f in topic.data_type.fields %}
      <tr>
        <td>{{ f.name }}</td>
        <td><code>{{ f.type_ref_render }}</code></td>
        <td>{{ "yes" if f.is_key else "" }}</td>
        <td>{{ f.meta.unit or "" }}</td>
        <td>{{ f.meta.description or f.doc or "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

</body>
</html>
